# Configuración de conexión a SQL Server
# Copia este archivo a `.env.local` y ajusta los valores reales del servidor.

# Host del SQL Server (IP o nombre). Si usas instancia nombrada, deja SQL_INSTANCE.
SQL_SERVER=localhost

# Puerto TCP (típicamente 1433). Coméntalo si usas instancia nombrada.
SQL_PORT=1433

# Instancia nombrada (ej. SQLEXPRESS). Déjalo vacío si no aplica.
# SQL_INSTANCE=SQLEXPRESS

SQL_DATABASE=DOSIPACK_CAMIONERA_OMYA
SQL_USER=DosiAdmin
SQL_PASSWORD=BACKFRONTFLIP

# TLS — para SQL Server local sin certificado dejar como abajo.
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true

# ─── Firebase / Firestore (sincronización a la nube) ─────────────────────
# Necesario para `npm run sync-cloud` y para el fallback del dashboard
# cuando SQL Server no está disponible.
# Estas tres variables vienen del JSON de la "Service Account" que se
# descarga desde Firebase Console → ⚙ Project settings → Service accounts
# → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# La clave privada se pega en una sola línea con \n literales
# (la copiás tal cual del JSON, entre comillas dobles).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Opcional — cantidad de movimientos a replicar.
# SYNC_TOP_N=2000
